<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/toolbar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dip"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="200dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/editor_log" />

                <LinearLayout
                    android:layout_width="0dip"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dip"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="24dp">

                            <Button
                                android:id="@+id/tv_select_apkfile"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="@string/select_apk_file" />

                            <Button
                                android:id="@+id/tv_select_appfile"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="@string/select_apk_from_app" />

                            <Button
                                android:id="@+id/download_manager"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="Tools Manager" />

                            <Button
                                android:id="@+id/tv_help"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="@string/help" />

                            <Button
                                android:id="@+id/tv_exit"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="@string/exit" />

                            <TextView
                                android:id="@+id/pirated_version_detected"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="Pirated Version Detected!"
                                android:textColor="#F44336"
                                android:visibility="gone" />

                        </LinearLayout>

                    </ScrollView>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <ListView
        android:id="@+id/slider_list"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/colorPrimary"
        android:choiceMode="singleChoice"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="16dip" />

</androidx.drawerlayout.widget.DrawerLayout>