<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.preference.PreferenceCategory
        android:layout="@layout/preferences_category"
        android:title="@string/about">
        <androidx.preference.Preference
            android:icon="@drawable/ic_about"
            android:title="@string/app_name">
            <intent android:action="com.mcal.action.SHOW_ABOUT" />
        </androidx.preference.Preference>
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:key="Appearance"
        android:layout="@layout/preferences_category"
        android:title="@string/appearance">

        <androidx.preference.ListPreference
            android:entries="@array/language_key"
            android:entryValues="@array/language_value"
            android:icon="@drawable/ic_language"
            android:key="Language"
            android:title="@string/preferred_language"
            app:useSimpleSummaryProvider="true" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:layout="@layout/preferences_category"
        android:title="@string/settings_connection_category">

        <androidx.preference.ListPreference
            android:defaultValue="hk"
            android:entries="@array/domain_com"
            android:entryValues="@array/domain_com_values"
            android:key="domain_hk"
            android:title="@string/settings_server_title"
            app:useSimpleSummaryProvider="true" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:layout="@layout/preferences_category"
        android:title="@string/others">

        <androidx.preference.Preference
            android:icon="@drawable/ic_delete"
            android:key="pref_clear_history"
            android:summary="@string/pref_summary_clear_history"
            android:title="@string/title_clear_history" />

        <!--        <com.mcal.apkeditor.dialogs.GarbageCleanPreference-->
        <!--            android:icon="@drawable/ic_delete"-->
        <!--            android:key="garbage_clean"-->
        <!--            android:summary="@string/clean_garbage_summary"-->
        <!--            android:title="@string/clean_garbage"-->
        <!--            android:entries="@array/garbage_deletion_key"-->
        <!--            android:entryValues="@array/garbage_deletion_value"/>-->

        <androidx.preference.SeekBarPreference
            android:key="garbage_limit"
            android:max="1536"
            app:defaultValue="512"
            app:icon="@drawable/ic_settings_cache_limit"
            app:min="256"
            app:seekBarIncrement="128"
            app:showSeekBarValue="true"
            app:summary="@string/garbage_limit_subtitle"
            app:title="@string/settings_garbage_limit"
            app:updatesContinuously="false" />

        <androidx.preference.ListPreference
            android:defaultValue="0"
            android:entries="@array/file_extract_rename_key"
            android:entryValues="@array/file_extract_rename_value"
            android:key="FileRenameOption"
            android:title="@string/file_rename"
            app:useSimpleSummaryProvider="true" />

    </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>