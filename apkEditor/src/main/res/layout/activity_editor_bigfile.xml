<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RelativeLayout
            android:id="@+id/menu_previous"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:src="@drawable/round_arrow_left_24" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/filename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/colorAccent" />

            <RelativeLayout
                android:id="@+id/menu_methods"
                android:layout_width="48dip"
                android:layout_height="40dip">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dip"
                    android:layout_height="24dip"
                    android:layout_centerInParent="true"
                    android:src="@drawable/round_view_list_24" />

            </RelativeLayout>

        </LinearLayout>


        <RelativeLayout
            android:id="@+id/menu_next"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:src="@drawable/round_arrow_right_24" />

        </RelativeLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/center_layout"
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.mcal.apkeditor.ui.LayoutObListView
                android:id="@+id/text_list"
                android:layout_width="match_parent"
                android:layout_height="0dip"
                android:layout_weight="1"
                android:descendantFocusability="beforeDescendants"
                android:dividerHeight="0px"
                android:scrollbarSize="2dip"
                android:scrollbarThumbVertical="@drawable/coloritem_cc"
                android:scrollbars="vertical" />

            <include layout="@layout/included_editor_menu" />
        </LinearLayout>

        <include layout="@layout/included_find_panel" />

    </FrameLayout>

</LinearLayout>