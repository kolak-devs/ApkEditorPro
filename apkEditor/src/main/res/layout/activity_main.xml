<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/AppTheme.ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:title="APK Editor" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.ModernButton"
                android:id="@+id/tv_select_apkfile"
                android:text="@string/select_apk_file" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.ModernButton"
                android:id="@+id/tv_select_appfile"
                android:text="@string/select_apk_from_app" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.ModernButton.Secondary"
                android:id="@+id/tv_help"
                android:text="@string/help" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.ModernButton.Secondary"
                android:id="@+id/tv_settings"
                android:text="@string/settings" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.ModernButton.Secondary"
                android:id="@+id/tv_exit"
                android:text="@string/exit" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
