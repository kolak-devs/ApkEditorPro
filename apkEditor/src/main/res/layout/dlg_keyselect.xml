<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dip">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dip"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_pk8path"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="@drawable/background_search"
            android:gravity="center|left"
            android:minHeight="45dp"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_weight="1"
            android:hint="@string/private_key_label" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_select_pk8"
            style="@style/Base.Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="40dip"
            android:layout_height="40dip"
            android:scaleType="fitCenter"
            android:src="@drawable/round_folder_blue_24" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dip"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_x509path"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="@drawable/background_search"
            android:gravity="center|left"
            android:minHeight="45dp"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_weight="1"
            android:hint="@string/public_key_label" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_select_x509"
            style="@style/Base.Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="40dip"
            android:layout_height="40dip"
            android:scaleType="fitCenter"
            android:src="@drawable/round_folder_blue_24" />

    </LinearLayout>

</LinearLayout>