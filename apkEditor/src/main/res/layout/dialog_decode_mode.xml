<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp">

    <CheckBox
        android:id="@+id/decode_assets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Decode Assets"
        style="@style/AppTheme.SweetCheckBox" />

    <CheckBox
        android:id="@+id/decode_resources"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Decode Resources"
        style="@style/AppTheme.SweetCheckBox"/>

    <CheckBox
        android:id="@+id/decode_classes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Decode Classes"
        style="@style/AppTheme.SweetCheckBox"/>

</LinearLayout>