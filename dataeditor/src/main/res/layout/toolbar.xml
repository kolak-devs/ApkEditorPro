<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:subtitleCentered="true"
        app:subtitleTextAppearance="@style/TextAppearance.MaterialComponents.Body2"
        app:titleCentered="true"
        app:titleTextAppearance="@style/AppTheme.ToolbarStyle"
        tools:navigationIcon="@drawable/ic_pan"
        tools:subtitle="v1.0 [arm64-v8a]"
        tools:title="ApkEditor Pro" />

</com.google.android.material.appbar.AppBarLayout>