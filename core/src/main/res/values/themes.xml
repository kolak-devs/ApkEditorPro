    <style name="ApkEditorTheme.Base.AMOLED" parent="ApkEditorTheme.Material3.AMOLED">
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:homeAsUpIndicator">@drawable/ic_pan</item>
    </style>

    <style name="AppTheme.AMOLED" parent="ApkEditorTheme.Base.AMOLED">
        <item name="colorRobotTone">#006d43</item>
        <item name="colorOnRobotTone">#ffffff</item>
        <item name="colorRobotToneContainer">#70fcb4</item>
        <item name="colorOnRobotToneContainer">#002111</item>
        <item name="harmonizeRobotTone">false</item>
        <item name="switchPreferenceStyle">@style/AppTheme.SwitchPreference</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="AppTheme.SwitchPreference" parent="Preference.SwitchPreference.Material">
    <item name="android:widgetLayout">@layout/preference_widget_materialswitch</item>
  </style>

    <style name="main_tab_bottom">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#666666</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1.0</item>
        <item name="android:button">@null</item>
    </style>

    <style name="AppTheme.ToolbarStyle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppTheme.ToolbarStyle.Subtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SweetSwitch" parent="TextAppearance.AppCompat.Widget.Switch">
        <item name="android:thumb">@drawable/toggle_switch</item>
        <item name="android:track">@drawable/ate_track</item>
    </style>

    <style name="AppTheme.SweetCheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:background">@drawable/sweet_checkbox</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">6dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Custom.MaterialAlertDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ThemeOverlay.Custom.MaterialAlertDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Custom.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.Custom.Dialog.Rounded" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_rounded</item>
    </style>
    
    <style name="MainCard">
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="cardCornerRadius">39dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="MainCardContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="MainCardTitle">
        <item name="android:id">@id/card_title</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:layout_toStartOf">@id/card_icon</item>
        <item name="android:layout_alignParentStart">true</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <style name="MainCardSummary">
        <item name="android:id">@id/card_summary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">24dp</item>
        <item name="android:layout_toStartOf">@id/card_icon</item>
        <item name="android:layout_below">@id/card_title</item>
        <item name="android:layout_alignParentStart">true</item>
        <item name="android:alpha">0.6</item>
        <item name="android:textAppearance">?android:textAppearanceSmall</item>
    </style>

    <style name="MainCardIcon">
        <item name="android:id">@id/card_icon</item>
        <item name="android:layout_width">55dp</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_centerVertical">true</item>
    </style>

</resources>