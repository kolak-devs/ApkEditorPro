<resources>

    <!-- ============================================== -->
    <!-- SATU TEMA UTAMA - Ubah di sini untuk semua      -->
    <!-- ============================================== -->

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorOnSecondary">@color/colorOnPrimary</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnError">@color/colorOnPrimary</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorControlActivated">@color/colorPrimary</item>
        <item name="android:colorControlHighlight">@color/colorControlHighlight</item>
        <item name="android:statusBarColor">@color/colorStatusBar</item>
        <item name="dialogTheme">@style/AppTheme.Dialog</item>
        <item name="alertDialogTheme">@style/AppTheme.Dialog.Alert</item>
        <item name="android:alertDialogTheme">@style/AppTheme.Dialog.Alert</item>
    </style>

    <!-- Untuk SettingActivity/SettingEditorActivity (butuh ActionBar) -->
    <style name="AppTheme.Settings" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:colorControlActivated">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="dialogTheme">@style/AppTheme.Dialog</item>
        <item name="alertDialogTheme">@style/AppTheme.Dialog.Alert</item>
        <item name="android:alertDialogTheme">@style/AppTheme.Dialog.Alert</item>
    </style>

    <style name="ShapeAppearance.AppOverlay.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Material DayNight dialog theme (for AlertDialog / dialogs) -->
    <style name="AppTheme.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:colorControlActivated">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/colorOnSurface</item>
        <item name="android:textColorSecondary">@color/colorOnSurface</item>
        <item name="android:textColorHint">@color/colorOnSurface</item>
        <item name="android:textColorAlertDialogListItem">@color/colorOnSurface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AppOverlay.Dialog</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AppOverlay.Dialog</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.AppOverlay.Dialog</item>
    </style>

    <style name="AppTheme.Dialog.Alert" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:colorControlActivated">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/colorOnSurface</item>
        <item name="android:textColorSecondary">@color/colorOnSurface</item>
        <item name="android:textColorHint">@color/colorOnSurface</item>
        <item name="android:textColorAlertDialogListItem">@color/colorOnSurface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AppOverlay.Dialog</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AppOverlay.Dialog</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.AppOverlay.Dialog</item>
    </style>

    <!-- Toolbar with centered title -->
    <style name="AppTheme.ToolbarStyle" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextAppearance">@style/AppTheme.ToolbarTitle</item>
        <item name="titleCentered">true</item>
    </style>

    <style name="AppTheme.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ============================================== -->
    <!-- Shared styles                                  -->
    <!-- ============================================== -->

    <!-- Modern Button Style -->
    <style name="Widget.ModernButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginStart">32dp</item>
        <item name="android:layout_marginEnd">32dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:gravity">center</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <style name="Widget.ModernButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginStart">32dp</item>
        <item name="android:layout_marginEnd">32dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:gravity">center</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="Dialog_No_Border_2">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTitleStyle">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="MyToggleButton" parent="@android:style/Widget.CompoundButton">
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/selector_togglebutton</item>
    </style>

    <style name="main_tab_bottom">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1.0</item>
        <item name="android:button">@null</item>
    </style>

    <style name="main_tab_left">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:button">@null</item>
        <item name="android:layout_marginRight">1.0dip</item>
    </style>

    <!-- ============================================== -->
    <!-- Modern Material button overrides (replace old   -->
    <!-- framework "button" styles from libraries so all -->
    <!-- buttons render as rounded filled Material style -->
    <!-- ============================================== -->
    <style name="button" parent="@android:style/Widget.Button">
        <item name="android:textSize">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_material_button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Shared alias for the different library button styles -->
    <style name="sql_button" parent="@style/button" />
    <style name="dark_button" parent="@style/button" />
    <style name="appdm_button" parent="@style/button" />

    <!-- Modern checkbox style used by PngEditor -->
    <style name="CheckBoxStyle" parent="Base.Theme.AppCompat">
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

</resources>
