<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.ToolbarStyle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ButtonBarStyle" parent="@android:style/Widget.Button">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">11sp</item>
        <item name="android:drawablePadding">-4dp</item>
        <item name="android:background">@drawable/button_bar_bg</item>
        <item name="android:layout_margin">2dp</item>
        <item name="textAllCaps">false</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:minHeight">42dp</item>
    </style>
</resources>